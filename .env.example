# ---- Black Box configuration (copy to .env; .env is git-ignored) ----

# Agent LLM provider: sandbox (offline, free) | openai (GPT-6 Luna) | ollama (local Qwen2.5-3B)
LLM_PROVIDER=sandbox

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=

# Requested temperature. Models that reject it (e.g. GPT-6 Luna) run at their default;
# reproducibility then comes from the response cache and K-variant replays with a Wilson interval.
LLM_TEMPERATURE=0
LLM_SEED=7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4

# Hard spending cap for billed OpenAI calls (USD). Calls stop once it is reached.
LLM_BUDGET_USD=0.5
# Only spend after this UTC time counts toward the cap (the GPT-6 Luna benchmarks, $0.65, ran before it).
LLM_BUDGET_START=2026-10-03T18:00:00+00:00
# gpt-5.4-nano pricing (USD per 1M tokens). GPT-6 Luna was 0.10 / 0.01 / 0.50.
LLM_PRICE_INPUT_PER_M=0.20
LLM_PRICE_CACHED_INPUT_PER_M=0.02
LLM_PRICE_OUTPUT_PER_M=1.25

# Ollama offline fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Context window for Ollama calls (long traces need more; ~8k fits a 3B model on 6 GB)
OLLAMA_NUM_CTX=8192

# Sandbox mistake rate per LLM call (0 = deterministic demo; datagen passes its own --noise)
SANDBOX_NOISE=0

# Storage
BLACKBOX_DB=data/traces.db
BLACKBOX_METRICS=data/metrics.json
BLACKBOX_MODEL_DIR=data/models
BLACKBOX_SEED_DEMO=true
BLACKBOX_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional OpenTelemetry export (e.g. Arize Phoenix http://localhost:6006 or Jaeger http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
BLACKBOX_OTEL_CONSOLE=false

# Explainer narrative: template | llm   (EXPLAINER_ADAPTER_PATH enables the QLoRA model)
EXPLAINER_NARRATIVE=template
# LLM narratives use local Ollama; set to openai only if you accept billed calls
EXPLAINER_LLM=ollama
# EXPLAINER_ADAPTER_PATH=data/models/blackbox-explainer

# Optional alerts: POST a Slack-compatible message when a run fails with p_fail above the threshold
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_P_FAIL_THRESHOLD=0.8
